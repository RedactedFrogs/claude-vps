# === GoCollect Farm Config ===

# 2captcha API key (WAJIB kalau TIDAK pakai --manual-captcha)
CAPTCHA_API_KEY=

# Turnstile sitekey (extract dari HTML/bundle GoCollect)
GC_SITEKEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

# Proxy untuk request ke GoCollect (SOCKS5 atau HTTP)
# Format SOCKS5: socks5://user:pass@host:port
# Format HTTP:   http://user:pass@host:port
PROXY_URL=

# Proxy format untuk 2captcha (passthrough supaya IP solve = IP request)
# Format: host:port (tanpa protocol)
CAPTCHA_PROXY=
CAPTCHA_PROXY_LOGIN=
CAPTCHA_PROXY_PASS=
CAPTCHA_PROXY_TYPE=socks5

# === Solana Wallet ===
# Seed phrase Phantom (file berisi 12/24 kata mnemonic)
SOLANA_SEED_FILE=/home/boss/.phantom_seed
# Jumlah wallet yang di-derive dari seed (default 1)
WALLET_COUNT=1
# ATAU file JSON array Solana private keys (bs58)
WALLETS_FILE=

# Koordinat GPS default (Jakarta contoh)
DEFAULT_LAT=-6.2088
DEFAULT_LNG=106.8456

# User-Agent (HARUS SAMA persis antara solve captcha dan request API)
USER_AGENT=Mozilla/5.0 (Linux; Android 14; Pixel 8 Pro) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Mobile Safari/537.36

# Max log size (bytes) - mencegah disk penuh
MAX_LOG_SIZE=10485760

# Delay antar wallet (ms)
WALLET_DELAY=5000

# === Telegram notifikasi untuk --manual-captcha ===
# Bot token Jarvis (dari @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID kamu (kirim /start ke bot, cek di getUpdates)
TELEGRAM_CHAT_ID=
# Port captcha server (default 18791)
CAPTCHA_PORT=18791
