# === GoCollect Farm v2 Config ===

# 2captcha API key (WAJIB kalau TIDAK pakai --manual-captcha)
CAPTCHA_API_KEY=

# Turnstile sitekey (auto-extract dari bundle via --update-keys)
GC_SITEKEY=

# === PROXY (WAJIB untuk multi-wallet) ===
# Single proxy (untuk 1 wallet):
PROXY_URL=
# ATAU file daftar proxy (1 baris = 1 proxy, format socks5://user:pass@host:port):
PROXY_LIST_FILE=proxies.txt

# Proxy untuk 2captcha passthrough:
CAPTCHA_PROXY=
CAPTCHA_PROXY_LOGIN=
CAPTCHA_PROXY_PASS=
CAPTCHA_PROXY_TYPE=socks5

# === Solana Wallet ===
# Seed phrase Phantom (file berisi 12/24 kata mnemonic)
SOLANA_SEED_FILE=/home/boss/.phantom_seed
# Jumlah wallet yang di-derive dari seed
WALLET_COUNT=1
# ATAU file JSON array Solana private keys (bs58)
WALLETS_FILE=

# Wallet utama untuk sweep (terima NFT + SOL dari wallet bot)
MAIN_WALLET=
# Solana RPC (default mainnet-beta)
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Minimum SOL yang ditahan di tiap wallet saat sweep
MIN_SOL_KEEP=0.002

# === GPS (lokasi awal, crate terdekat dari sini) ===
DEFAULT_LAT=-6.2088
DEFAULT_LNG=106.8456

# === Anti-ban Pattern ===
# Jumlah crate sebelum break
CRATES_PER_SESSION=8
# Durasi break (menit)
BREAK_MIN_MINUTES=3
BREAK_MAX_MINUTES=7
# Delay antar wallet (ms)
WALLET_DELAY=15000
# Interval loop (jam, untuk --loop)
LOOP_HOURS=6

# User-Agent (HARUS SAMA persis antara solve captcha dan request API)
USER_AGENT=Mozilla/5.0 (Linux; Android 14; Pixel 8 Pro) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Mobile Safari/537.36

# Max log size (bytes) — mencegah disk penuh
MAX_LOG_SIZE=10485760

# === Telegram (untuk notifikasi captcha + win alert + daily report) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Port captcha server (untuk --manual-captcha)
CAPTCHA_PORT=18791
# Port dashboard
DASHBOARD_PORT=18792
