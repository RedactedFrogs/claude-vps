{
  "name": "gc-farm",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "update-keys": "node gc-farm.mjs --update-keys",
    "diagnose": "node gc-farm.mjs --diagnose",
    "dry-run": "node gc-farm.mjs --dry-run --wallet 0",
    "live-test": "node gc-farm.mjs --live --manual-captcha --wallet 0",
    "live-all": "node gc-farm.mjs --live --manual-captcha",
    "live-loop": "node gc-farm.mjs --live --loop --manual-captcha",
    "dashboard": "node gc-dashboard.mjs",
    "sweep-check": "node gc-sweep.mjs --check",
    "sweep-nft": "node gc-sweep.mjs --sweep-nft",
    "sweep-sol": "node gc-sweep.mjs --sweep-sol"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^1.3.0",
    "socks-proxy-agent": "^8.0.0",
    "tweetnacl": "^1.0.3"
  }
}
