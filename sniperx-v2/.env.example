# === RPC Endpoints ===
# Alchemy (free tier: 300M compute units/month)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Additional RPCs (optional, for rotation)
ETH_RPC_EXTRA=https://eth.llamarpc.com,https://rpc.ankr.com/eth
BASE_RPC_EXTRA=https://base.llamarpc.com,https://rpc.ankr.com/base
BSC_RPC_EXTRA=https://bsc-dataseed.binance.org,https://rpc.ankr.com/bsc
SOLANA_RPC_EXTRA=https://api.mainnet-beta.solana.com

# === Wallets ===
WALLETS_PATH=/home/boss/.pixelpals_wallets.json
MAIN_WALLET_KEY_PATH=/home/boss/.sniper_key
SOCIALS_PATH=./config/wallet-socials.json

# === Proxy (optional) ===
PROXY_ENABLED=false
PROXY_LIST_PATH=./config/proxies.txt
# Format per line: protocol://user:pass@host:port
# Example: socks5://user:pass@1.2.3.4:1080

# === Dashboard ===
DASHBOARD_PORT=3847
DASHBOARD_PASSWORD=change_this_password

# === Telegram Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Sniper Settings ===
DEFAULT_SLIPPAGE=15
DEFAULT_GAS_MULTIPLIER=1.3
STAGGER_MIN_MS=50
STAGGER_MAX_MS=200
MAX_CONCURRENT_WALLETS=80
